
<group name="syslog,sshd,">
  <rule id="100001" level="10" frequency="4" timeframe="120">
    <if_matched_sid>2501</if_matched_sid>
    <same_source_ip />
    <description>Wykryto SSH Brute Force - wiele błędnych logowań z jednego IP</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures</group>
  </rule>
</group>

<group name="web,reconnaissance,">
  <rule id="100020" level="7">
    <if_sid>31100</if_sid>
    <field name="user_agent">gobuster|Nikto|dirbuster|sqlmap</field>
    <description>SOC-Lab: Detected Web Reconnaissance Tool User-Agent ($(user_agent))</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
  </rule>

  <rule id="100021" level="10" frequency="15" timeframe="10">
    <if_matched_sid>31108</if_matched_sid>
    <same_source_ip />
    <description>SOC-Lab: Potential Web Directory Brute-Force Attack from IP $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>
