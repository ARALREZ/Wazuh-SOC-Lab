<group name="local,web,web_attack_detection,">

  <!-- 100028: Trusted source - Fedora -->
  <rule id="100028" level="3">
    <if_sid>31100,31108</if_sid>
    <srcip>192.168.122.1</srcip>
    <description>WEB TRUSTED: HTTP request from trusted Fedora source $(srcip)</description>
    <group>web,trusted_source,</group>
  </rule>

  <!-- 100020: Automated web scanner -->
  <rule id="100020" level="6">
    <if_sid>31100,31108,31508</if_sid>
    <srcip negate="yes">192.168.122.1</srcip>
    <regex type="pcre2">(?i)"(?:Nikto|sqlmap|Nmap|Acunetix|Nessus|WPScan|DirBuster|Gobuster|ffuf|Nuclei)(?:/|\s|")</regex>
    <description>WEB RECON: Automated vulnerability scanner detected from $(srcip)</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
    <group>web_scanner,reconnaissance,</group>
  </rule>

  <!-- 100021: SQL Injection -->
  <rule id="100021" level="10">
    <if_sid>31103</if_sid>
    <srcip negate="yes">192.168.122.1</srcip>
    <description>WEB ATTACK: SQL Injection detected from $(srcip), URL: $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,web_attack_high,sql_injection,</group>
  </rule>

  <!-- 100022: Cross-Site Scripting -->
  <rule id="100022" level="10">
    <if_sid>31105</if_sid>
    <srcip negate="yes">192.168.122.1</srcip>
    <description>WEB ATTACK: Cross-Site Scripting attempt from $(srcip), URL: $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,web_attack_high,xss,</group>
  </rule>

  <!-- 100023: Path Traversal / Local File Inclusion -->
  <rule id="100023" level="10">
    <if_sid>31104</if_sid>
    <srcip negate="yes">192.168.122.1</srcip>
    <url type="pcre2">(?i)(\.\./|%2e%2e(?:%2f|/)|%252e%252e|/etc/(?:passwd|shadow)|%2fetc%2f(?:passwd|shadow)|/proc/self/environ)</url>
    <description>WEB ATTACK: Path Traversal or LFI attempt from $(srcip), URL: $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,web_attack_high,path_traversal,lfi,</group>
  </rule>

  <!-- 100024: Command Injection -->
  <rule id="100024" level="12">
    <if_sid>31100</if_sid>
    <srcip negate="yes">192.168.122.1</srcip>
    <url type="pcre2">(?i)(?:;|%3b|\||%7c|%26%26|&amp;&amp;|%60|`|%24%28|\$\().{0,60}(?:id|whoami|uname|cat|wget|curl|nc|bash|sh|python)(?:%20|\+|%2f|/|$)</url>
    <description>WEB CRITICAL: Command Injection pattern detected from $(srcip), URL: $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,web_attack_high,command_injection,</group>
  </rule>

  <!-- 100025: Repeated scanner activity - 5 events / 120 seconds -->
  <rule id="100025" level="9" frequency="5" timeframe="120">
    <if_matched_sid>100020</if_matched_sid>
    <same_srcip />
    <srcip negate="yes">192.168.122.1</srcip>
    <description>WEB RECON: Repeated scanner activity from $(srcip) - 5 detections within 120 seconds</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
    <group>web_scanner,web_correlation,reconnaissance,</group>
  </rule>

  <!-- 100026: Multiple web attacks - 3 events / 180 seconds -->
  <rule id="100026" level="12" frequency="4" timeframe="180">
    <if_matched_group>web_attack_high</if_matched_group>
    <same_srcip />
    <srcip negate="yes">192.168.122.1</srcip>
    <description>WEB CRITICAL: Multiple web attacks from $(srcip) within 180 seconds</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,web_correlation,critical,</group>
  </rule>

  <!-- 100027: Scanner activity followed by exploitation -->
  <rule id="100027" level="13" frequency="3" timeframe="300">
    <if_sid>100021,100022,100023,100024</if_sid>
    <if_matched_sid>100020</if_matched_sid>
    <same_srcip />
    <srcip negate="yes">192.168.122.1</srcip>
    <description>WEB CRITICAL: Repeated scanner activity followed by exploitation attempt from $(srcip)</description>
    <mitre>
      <id>T1595.002</id>
      <id>T1190</id>
    </mitre>
    <group>web_attack,web_correlation,critical,scanner_then_exploit,</group>
  </rule>

  <!-- 100029: Suspicious URI schemes and patterns -->
  <rule id="100029" level="5">
    <if_sid>31100</if_sid>
    <srcip negate="yes">192.168.122.1</srcip>
    <url type="pcre2">(?i)(?:php://|data://|expect://|php%3a%2f%2f|data%3a%2f%2f|expect%3a%2f%2f|base64_decode|eval%28)</url>
    <description>WEB SUSPICIOUS: Suspicious URI scheme or PHP execution pattern from $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_suspicious,web_monitoring,</group>
  </rule>

</group>
