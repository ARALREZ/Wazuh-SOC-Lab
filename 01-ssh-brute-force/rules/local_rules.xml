<!-- Grupa logowań i systemu (SSH, ogólne) -->
<group name="local,syslog,sshd">

  <rule id="100001" level="10" frequency="4" timeframe="120">
    <if_matched_sid>2501</if_matched_sid>
    <same_source_ip />
    <description>Wykryto SSH Brute Force - wiele błędnych logowań z jednego IP</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures</group>
  </rule>

</group>

