<group name="local,syslog,sshd,custom_detection,">

  <!-- Trusted Fedora administrator -->
  <rule id="100010" level="3">
    <if_sid>5760</if_sid>
    <srcip>192.168.122.1</srcip>
    <description>Trusted IP: SSH authentication failure from $(srcip)</description>
    <group>authentication_failed,trusted_source,</group>
  </rule>

  <!-- Soft detection - matches PNG level 6 -->
  <rule id="100001" level="6" frequency="3" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <srcip negate="yes">192.168.122.1</srcip>
    <description>SSH Multiple authentication failures from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,ssh_brute_force,</group>
  </rule>

  <!-- Brute force - matches PNG level 10 + triggers AR -->
  <rule id="100002" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <srcip negate="yes">192.168.122.1</srcip>
    <description>SSH Brute Force attack detected from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,brute_force,ssh_brute_force,</group>
  </rule>

  <!-- Critical correlation after brute force -->
  <rule id="100005" level="14" frequency="2" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>100001</if_matched_sid>
    <same_srcip />
    <same_user />
    <srcip negate="yes">192.168.122.1</srcip>
    <description>CRITICAL: Successful SSH login after brute force from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
      <id>T1021.004</id>
    </mitre>
    <group>authentication_success,brute_force,possible_compromise,</group>
  </rule>

</group>
