<group name="local,syslog,sshd,custom_detection,">

  <!-- Trusted Fedora administrator -->
  <rule id="100010" level="3">
    <if_sid>5760</if_sid>
    <srcip>192.168.122.1</srcip>
    <description>
      SSH: Failed authentication from trusted administration host $(srcip)
    </description>
    <group>authentication_failed,trusted_source,</group>
  </rule>

  <!--Custom SSH brute-force critical: 3 failures / 120 seconds --> 
  <rule id="100001" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>SSH brute-force detected: 3 failed login attempts</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,ssh_brute_force,</group>
  </rule>

<!-- Custom SSH brute-force critical: 8 failures / 120 seconds -->
<rule id="100002" level="12" frequency="8" timeframe="120">
  <if_matched_sid>5760</if_matched_sid>
  <same_srcip />
  <srcip negate="yes">192.168.122.1</srcip>
  <description>
    SSH BRUTE FORCE CRITICAL:
    8 or more failed SSH authentications from $(srcip)
    within 120 seconds.
  </description>
  <mitre>
    <id>T1110.001</id>
  </mitre>
  <group>authentication_failed,brute_force,ssh_brute_force,</group>
</rule>

  <!-- Successful login following 2 previous brute-force alerts -->
  <rule id="100005" level="14"
        frequency="2" timeframe="300">

    <if_sid>5715</if_sid>
    <if_matched_sid>100001</if_matched_sid>

    <same_srcip />
    <same_user />
    <srcip negate="yes">192.168.122.1</srcip>

    <description>
      CRITICAL: Successful SSH authentication following
      two previous brute-force warning alerts for the same account
      from $(srcip) within 300 seconds.
    </description>

    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
      <id>T1021.004</id>
    </mitre>

    <group>authentication_success,brute_force,possible_compromise,</group>
  </rule>

</group>
