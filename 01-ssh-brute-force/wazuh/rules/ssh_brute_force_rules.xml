<group name="syslog,sshd,custom_detection,">

  <!-- Trusted IP: show low-level alert in Dashboard -->
  <rule id="100010" level="3">
    <if_sid>5760</if_sid>
    <srcip>192.168.122.1</srcip>
    <description>Trusted IP: SSH authentication failure from 192.168.122.1</description>
    <group>authentication_failures,whitelist,</group>
  </rule>

  <!-- 3 failed SSH attempts within 90 seconds, excluding trusted IP -->
  <rule id="100001" level="6" frequency="3" timeframe="90">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <srcip negate="yes">192.168.122.1</srcip>
    <description>SSH: Multiple authentication failures from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- 5 failed SSH attempts within 120 seconds, excluding trusted IP -->
  <rule id="100002" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <srcip negate="yes">192.168.122.1</srcip>
    <description>SSH Brute Force attack detected from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- Successful SSH login after recent brute-force detection -->
  <rule id="100005" level="14" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>100001</if_matched_sid>
    <same_srcip />
    <description>CRITICAL: Successful SSH login after brute force from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,compromise,</group>
  </rule>

</group>
