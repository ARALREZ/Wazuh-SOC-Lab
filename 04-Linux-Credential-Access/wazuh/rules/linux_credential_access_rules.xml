<group name="local,audit,linux,credential_access,">

  <rule id="100040" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.key">^shadow_access$</field>
    <field name="audit.success">^no$</field>
    <description>Credential Access: denied access to /etc/shadow by login UID $(audit.auid)</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
    <group>credential_access,authentication_failed,</group>
  </rule>

  <rule id="100041" level="10" frequency="3" timeframe="90">
    <if_matched_sid>100040</if_matched_sid>
    <same_field>audit.auid</same_field>
    <description>Credential Access: repeated denied access to /etc/shadow by the same login UID</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
    <group>credential_access,credential_access_multiple,</group>
  </rule>

  <rule id="100042" level="12" frequency="4" timeframe="120">
    <if_matched_sid>100040</if_matched_sid>
    <same_field>audit.auid</same_field>
    <description>CRITICAL: repeated credential access attempts against /etc/shadow by the same login UID</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
    <group>credential_access,credential_access_critical,</group>
  </rule>

</group>
