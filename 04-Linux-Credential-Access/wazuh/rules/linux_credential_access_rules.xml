<!--
  Scenario 04: Linux Credential Access Detection
  MITRE: T1003.008 - OS Credential Dumping: /etc/shadow
-->

<group name="linux,credential_access,auditd,">

  <!-- 100040: Soft - every attempt -->
  <rule id="100040" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.key">shadow_access</field>
    <description>Auditd: Unauthorized attempt to access /etc/shadow (soft)</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
  </rule>

  <!-- 100041: Medium - 3 attempts in 90s (visible alert) -->
  <rule id="100041" level="10" frequency="3" timeframe="90">
    <if_matched_sid>100040</if_matched_sid>
    <description>Auditd: Multiple unauthorized attempts to access /etc/shadow (medium)</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
  </rule>

  <!-- 100042: Critical - 5 attempts in 120s + Active Response -->
  <rule id="100042" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100040</if_matched_sid>
    <description>CRITICAL: Credential Access - multiple /etc/shadow attempts. Triggering containment.</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
  </rule>

</group>
